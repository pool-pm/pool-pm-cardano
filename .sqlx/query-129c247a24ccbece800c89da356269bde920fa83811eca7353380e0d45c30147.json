  "query": "SELECT tx_out.id, a.address, tx_out.value\n            FROM tx_out\n            JOIN tx ON tx.id = tx_out.tx_id\n            JOIN address a ON a.id = tx_out.address_id\n            WHERE tx.hash = $1 AND tx_out.index = $2",
